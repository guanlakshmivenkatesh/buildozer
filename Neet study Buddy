import tkinter as tk
from tkinter import ttk, messagebox, scrolledtext
import json
import time
import threading
from datetime import datetime, timedelta
import requests
import sqlite3

class NEETStudyAssistant:
    def __init__(self, root):
        self.root = root
        self.root.title("NEET Study Assistant 🤖")
        self.root.geometry("900x700")
        self.root.configure(bg='#f0f8ff')
        
        # Database setup
        self.setup_database()
        
        # Study schedule
        self.study_schedule = {
            "Physics": ["Mechanics", "Optics", "Electromagnetism", "Modern Physics"],
            "Chemistry": ["Organic", "Inorganic", "Physical Chemistry"],
            "Biology": ["Botany", "Zoology", "Human Physiology", "Genetics"]
        }
        
        # Pomodoro timer variables
        self.study_time = 25 * 60  # 25 minutes
        self.break_time = 5 * 60   # 5 minutes
        self.current_time = self.study_time
        self.is_running = False
        self.is_break = False
        
        self.create_widgets()
        self.load_schedule()
    
    def setup_database(self):
        """Initialize SQLite database for study sessions"""
        self.conn = sqlite3.connect('neet_study.db')
        self.cursor = self.conn.cursor()
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS study_sessions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                subject TEXT,
                topic TEXT,
                duration INTEGER,
                date TEXT
            )
        ''')
        self.conn.commit()
    
    def create_widgets(self):
        # Main frame
        main_frame = ttk.Frame(self.root, padding="10")
        main_frame.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))
        
        # Title
        title_label = tk.Label(main_frame, text="🧬 NEET Study Assistant", 
                              font=('Arial', 20, 'bold'), bg='#f0f8ff', fg='#2c3e50')
        title_label.grid(row=0, column=0, columnspan=2, pady=10)
        
        # Left frame - Study tools
        left_frame = ttk.LabelFrame(main_frame, text="Study Tools", padding="10")
        left_frame.grid(row=1, column=0, sticky=(tk.W, tk.E, tk.N, tk.S), padx=(0, 5))
        
        # Right frame - AI Chat
        right_frame = ttk.LabelFrame(main_frame, text="AI Study Helper", padding="10")
        right_frame.grid(row=1, column=1, sticky=(tk.W, tk.E, tk.N, tk.S), padx=(5, 0))
        
        # Configure grid weights
        main_frame.columnconfigure(0, weight=1)
        main_frame.columnconfigure(1, weight=1)
        main_frame.rowconfigure(1, weight=1)
        
        self.create_study_tools(left_frame)
        self.create_chat_interface(right_frame)
    
    def create_study_tools(self, parent):
        # Pomodoro Timer
        timer_frame = ttk.Frame(parent)
        timer_frame.grid(row=0, column=0, sticky=(tk.W, tk.E), pady=5)
        
        self.timer_label = tk.Label(timer_frame, text="25:00", 
                                   font=('Arial', 24, 'bold'), fg='#e74c3c')
        self.timer_label.grid(row=0, column=0, columnspan=3, pady=5)
        
        self.timer_status = tk.Label(timer_frame, text="Study Time - Physics: Mechanics", 
                                    font=('Arial', 10), fg='#34495e')
        self.timer_status.grid(row=1, column=0, columnspan=3, pady=2)
        
        ttk.Button(timer_frame, text="Start", command=self.start_timer).grid(row=2, column=0, padx=2)
        ttk.Button(timer_frame, text="Pause", command=self.pause_timer).grid(row=2, column=1, padx=2)
        ttk.Button(timer_frame, text="Reset", command=self.reset_timer).grid(row=2, column=2, padx=2)
        
        # Study Schedule
        schedule_frame = ttk.LabelFrame(parent, text="Today's Study Plan")
        schedule_frame.grid(row=1, column=0, sticky=(tk.W, tk.E, tk.N, tk.S), pady=10)
        
        self.schedule_text = scrolledtext.ScrolledText(schedule_frame, height=8, width=40)
        self.schedule_text.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))
        
        # Quick subject buttons
        subjects_frame = ttk.Frame(parent)
        subjects_frame.grid(row=2, column=0, sticky=(tk.W, tk.E), pady=5)
        
        ttk.Button(subjects_frame, text="Physics", 
                  command=lambda: self.set_subject("Physics")).grid(row=0, column=0, padx=2)
        ttk.Button(subjects_frame, text="Chemistry", 
                  command=lambda: self.set_subject("Chemistry")).grid(row=0, column=1, padx=2)
        ttk.Button(subjects_frame, text="Biology", 
                  command=lambda: self.set_subject("Biology")).grid(row=0, column=2, padx=2)
        
        # Progress tracking
        progress_frame = ttk.LabelFrame(parent, text="Study Progress")
        progress_frame.grid(row=3, column=0, sticky=(tk.W, tk.E), pady=5)
        
        self.progress_label = tk.Label(progress_frame, text="Today: 0 sessions completed", 
                                      font=('Arial', 10))
        self.progress_label.grid(row=0, column=0, sticky=tk.W)
        
        parent.columnconfigure(0, weight=1)
        parent.rowconfigure(1, weight=1)
    
    def create_chat_interface(self, parent):
        # Chat display
        self.chat_display = scrolledtext.ScrolledText(parent, height=20, width=50, state=tk.DISABLED)
        self.chat_display.grid(row=0, column=0, columnspan=2, sticky=(tk.W, tk.E, tk.N, tk.S), pady=5)
        
        # User input
        self.user_input = tk.Entry(parent, width=40)
        self.user_input.grid(row=1, column=0, sticky=(tk.W, tk.E), pady=5)
        self.user_input.bind('<Return>', lambda e: self.send_message())
        
        ttk.Button(parent, text="Send", command=self.send_message).grid(row=1, column=1, padx=5)
        
        # Quick study questions
        quick_questions_frame = ttk.Frame(parent)
        quick_questions_frame.grid(row=2, column=0, columnspan=2, sticky=(tk.W, tk.E), pady=5)
        
        questions = [
            "Explain photosynthesis",
            "Newton's laws",
            "Organic chemistry basics",
            "Study tips"
        ]
        
        for i, question in enumerate(questions):
            ttk.Button(quick_questions_frame, text=question,
                      command=lambda q=question: self.quick_question(q)).grid(row=0, column=i, padx=2)
        
        parent.columnconfigure(0, weight=1)
        parent.rowconfigure(0, weight=1)
        
        # Initial welcome message
        self.add_to_chat("AI Assistant", "Hello! I'm your NEET study assistant. I can help with:\n- Physics concepts\n- Chemistry explanations\n- Biology topics\n- Study strategies\n- Problem solving\n\nWhat would you like to study today?")
    
    def start_timer(self):
        if not self.is_running:
            self.is_running = True
            self.timer_thread = threading.Thread(target=self.run_timer)
            self.timer_thread.daemon = True
            self.timer_thread.start()
    
    def pause_timer(self):
        self.is_running = False
    
    def reset_timer(self):
        self.is_running = False
        self.is_break = False
        self.current_time = self.study_time
        self.update_timer_display()
        self.timer_status.config(text="Study Time - Ready")
    
    def run_timer(self):
        while self.is_running and self.current_time > 0:
            time.sleep(1)
            self.current_time -= 1
            self.update_timer_display()
        
        if self.current_time == 0 and self.is_running:
            self.is_running = False
            self.complete_session()
    
    def update_timer_display(self):
        minutes = self.current_time // 60
        seconds = self.current_time % 60
        self.timer_label.config(text=f"{minutes:02d}:{seconds:02d}")
        
        status = "Break Time" if self.is_break else "Study Time"
        self.timer_status.config(text=status)
    
    def complete_session(self):
        subject = "Physics"  # Default, you can make this dynamic
        topic = "Current Topic"
        
        # Save session to database
        self.cursor.execute('''
            INSERT INTO study_sessions (subject, topic, duration, date)
            VALUES (?, ?, ?, ?)
        ''', (subject, topic, self.study_time, datetime.now().isoformat()))
        self.conn.commit()
        
        # Show completion message
        if self.is_break:
            messagebox.showinfo("Break Over", "Break time is over! Ready for next study session?")
            self.is_break = False
            self.current_time = self.study_time
        else:
            messagebox.showinfo("Session Complete", "Great job! Study session completed. Time for a break!")
            self.is_break = True
            self.current_time = self.break_time
        
        self.update_progress()
        self.start_timer()  # Auto-start next session
    
    def set_subject(self, subject):
        topics = self.study_schedule.get(subject, [])
        topic_str = "\n".join([f"• {topic}" for topic in topics])
        self.timer_status.config(text=f"Study Time - {subject}: {topics[0] if topics else 'General'}")
        self.add_to_chat("System", f"Switched to {subject}. Recommended topics:\n{topic_str}")
    
    def load_schedule(self):
        schedule = """📚 Today's NEET Study Plan:

Morning (8-10 AM): Physics - Mechanics
• Newton's Laws of Motion
• Work, Energy, Power

Late Morning (10:30-12:30): Chemistry - Organic
• Basic Principles
• Hydrocarbons

Afternoon (2-4 PM): Biology - Botany
• Plant Physiology
• Morphology

Evening (4:30-6:30): Biology - Zoology
• Human Physiology
• Animal Kingdom

Night (7-9 PM): Revision & Practice"""
        
        self.schedule_text.insert(tk.END, schedule)
        self.schedule_text.config(state=tk.DISABLED)
    
    def update_progress(self):
        # Count today's sessions
        today = datetime.now().date().isoformat()
        self.cursor.execute('''
            SELECT COUNT(*) FROM study_sessions 
            WHERE date LIKE ?
        ''', (f"{today}%",))
        count = self.cursor.fetchone()[0]
        self.progress_label.config(text=f"Today: {count} sessions completed")
    
    def send_message(self):
        message = self.user_input.get().strip()
        if message:
            self.add_to_chat("You", message)
            self.user_input.delete(0, tk.END)
            self.process_message(message)
    
    def quick_question(self, question):
        self.user_input.delete(0, tk.END)
        self.user_input.insert(0, question)
        self.send_message()
    
    def add_to_chat(self, sender, message):
        self.chat_display.config(state=tk.NORMAL)
        self.chat_display.insert(tk.END, f"\n{sender}: {message}\n")
        self.chat_display.config(state=tk.DISABLED)
        self.chat_display.see(tk.END)
    
    def process_message(self, message):
        # Simple AI response system (you can enhance this with actual AI API)
        response = self.generate_response(message.lower())
        self.add_to_chat("AI Assistant", response)
    
    def generate_response(self, message):
        # NEET-focused responses
        responses = {
            'physics': """🔬 **Physics Study Tips:**
            • Focus on NCERT concepts first
            • Practice numerical problems daily
            • Important topics: Mechanics, Optics, Modern Physics
            • Use diagrams for better understanding
            • Revise formulas regularly""",
            
            'chemistry': """🧪 **Chemistry Strategy:**
            • **Organic:** Reaction mechanisms, named reactions
            • **Inorganic:** Periodic table, coordination compounds
            • **Physical:** Mole concept, thermodynamics
            • Practice balancing equations
            • Focus on NCERT examples""",
            
            'biology': """🌿 **Biology Focus Areas:**
            • Human Physiology (most important)
            • Genetics and Evolution
            • Plant Physiology
            • Reproduction
            • Ecology and Environment
            • Diagram practice is crucial!""",
            
            'study tips': """📖 **Effective NEET Study Plan:**
            • 8-10 hours daily study
            • Regular revisions
            • Mock tests weekly
            • Focus on weak areas
            • Health and sleep are important
            • Use Pomodoro technique (25min study, 5min break)""",
            
            'photosynthesis': """🌱 **Photosynthesis:**
            • Process: 6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂
            • Light and dark reactions
            • Chlorophyll absorbs light energy
            • Calvin cycle for carbon fixation
            • Factors: Light intensity, CO₂, temperature""",
            
            "newton's laws": """📐 **Newton's Laws of Motion:**
            1. **First Law:** Inertia - object at rest stays at rest
            2. **Second Law:** F = ma
            3. **Third Law:** Action-reaction pairs
            • Important for NEET: Applications in daily life, numerical problems"""
        }
        
        # Find the best matching response
        for key in responses:
            if key in message:
                return responses[key]
        
        # Default response for unrecognized queries
        return """I can help you with NEET preparation in:
• Physics concepts and problems
• Chemistry explanations
• Biology topics and diagrams
• Study strategies and time management
• Specific topic explanations

Try asking about:
- Photosynthesis process
- Newton's laws applications  
- Organic chemistry basics
- Human physiology topics
- Study schedule planning"""

def main():
    root = tk.Tk()
    app = NEETStudyAssistant(root)
    root.mainloop()

if __name__ == "__main__":
    main()
